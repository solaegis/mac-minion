    "Each addon folder in the backup replaces the one you have; yours go to the Trash.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder AddOn-Ordner im Backup ersetzt Ihren; Ihre kommen in den Papierkorb."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada carpeta de addon de la copia sustituye a la tuya; las tuyas van a la Papelera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque dossier d'addon de la sauvegarde remplace le vôtre ; les vôtres vont à la corbeille."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая папка аддона из резервной копии заменяет вашу; ваши попадают в Корзину."
          }
        }
      }
    },

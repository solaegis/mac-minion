    "%@ more. Switch to Tree to see them all.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mehr. Wechseln Sie zu Tree, um sie alle zu sehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ más. Cambia a Tree para verlos todos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ plus. Basculez sur l'Arbre pour les voir tous."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ больше. Перейдите в Дерево, чтобы увидеть их все."
          }

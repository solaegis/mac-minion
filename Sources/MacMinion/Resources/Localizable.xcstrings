    "%@ · thumbs up or down to steer it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Daumen hoch oder runter, um es zu steuern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · pulgar hacia arriba o hacia abajo para guiarlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · pouce levé ou baissé pour l'orienter"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · лайк или дизлайк, чтобы повлиять на него"

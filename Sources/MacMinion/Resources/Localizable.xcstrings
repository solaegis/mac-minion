    "Addon names and changelog text are sent to Anthropic, and nowhere else.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "AddOn-Namen und Änderungsprotokolle werden an Anthropic gesendet, und sonst nirgendwohin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de los addons y el texto de los cambios se envían a Anthropic, y a ningún otro sitio."

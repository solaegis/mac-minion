    "Your accounts, then other players your addons keep data about, like guild members and traders.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Accounts, dann andere Spieler, über die Ihre AddOns Daten speichern, etwa Gildenmitglieder und Händler."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus cuentas y luego otros jugadores de los que tus addons guardan datos, como miembros de gremio y comerciantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos comptes, puis les autres joueurs sur lesquels vos addons gardent des données, comme les membres de guilde et les marchands."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши аккаунты, затем другие игроки, о которых аддоны хранят данные, например члены гильдии и торговцы."
          }
        }
      }

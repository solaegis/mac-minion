    "%@ won't load without it, so it shows even with a thumbs down": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt nicht ohne es, daher wird es trotz Daumen runter angezeigt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no se carga sin él, así que aparece aunque tenga un pulgar abajo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne se charge pas sans lui, il reste donc affiché malgré un pouce vers le bas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не загрузится без него, поэтому он показан даже с оценкой «не нравится»"
          }
        }
      }
    },

    "The values of %@ are replaced in each addon's SavedVariables file. MacMinion backs up first; restore the backup to undo.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Werte von %@ werden in der SavedVariables-Datei jedes Addons ersetzt. MacMinion erstellt zuerst ein Backup; stelle es wieder her, um die Änderung rückgängig zu machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores de %@ se reemplazan en el archivo SavedVariables de cada addon. MacMinion hace una copia de seguridad antes; restáurala para deshacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs de %@ sont remplacées dans le fichier SavedVariables de chaque addon. MacMinion sauvegarde d’abord ; restaurez la sauvegarde pour annuler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Значения %@ заменяются в файле SavedVariables каждого аддона. MacMinion сначала делает резервную копию; восстановите её, чтобы отменить."
          }
        }
      }
    },

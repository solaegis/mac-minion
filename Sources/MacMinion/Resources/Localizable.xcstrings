    "%lld settings, %lld set differently from your other characters. Click one to compare.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Einstellungen, %lld ist anders eingestellt als Ihre anderen Charaktere. Klicken Sie auf einen, um zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld settings, %2$lld set differently from your other characters. Click one to compare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ajustes, %lld configurado de manera diferente de tus otros personajes. Haz clic en uno para comparar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld paramètres, %lld configuré différemment de vos autres personnages. Cliquez sur l'un d'eux pour comparer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld настройки, %lld настроены иначе, чем у ваших других персонажей. Нажмите, чтобы сравнить."
          }
        }
      }
    },

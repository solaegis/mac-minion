    "Every SavedVariables file belongs to an installed addon or the game.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede SavedVariables Datei gehört zu einem installierten AddOn oder dem Spiel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada archivo de SavedVariables pertenece a un addon instalado o al juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier SavedVariables appartient à un addon installé ou au jeu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый файл SavedVariables принадлежит установленному аддону или игре."
          }
        }
      }
    },
    "Every SavedVariables file is in use, reads cleanly, and matches what its addon declares.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede SavedVariables Datei wird verwendet, ist sauber und entspricht der Deklaration ihres AddOns."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada archivo de SavedVariables está en uso, se lee correctamente y coincide con lo que declara su addon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque fichier SavedVariables est utilisé, est lisible et correspond à ce que son addon déclare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый файл SavedVariables используется, читается корректно и соответствует тому, что заявляет его аддон."
          }
        }
      }
    },

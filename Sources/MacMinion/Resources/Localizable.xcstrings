    "Install another version from ESOUI. An older version is pinned: Update All skips it until you install the latest.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiere eine andere Version von ESOUI. Eine ältere Version ist festgenagelt: Update All überspringt sie, bis du die neueste installierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalar otra versión desde ESOUI. Una versión anterior está anclada: Actualizar Todo la omite hasta que instales la más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer une autre version depuis ESOUI. Une version plus ancienne est épinglée : Mettre à jour tout ignore cette version tant que vous n'installez pas la plus récente."
          }
        },
        "ru": {

    "%lld addons keep settings for each of your %lld characters. Darker squares hold more settings; outlined ones have settings set differently from your other characters.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld AddOns speichern Einstellungen für jeden Ihrer %lld Charaktere. Dunklere Felder enthalten mehr Einstellungen; umrandete haben Einstellungen, die anders sind als bei Ihren anderen Charakteren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld addons guardan ajustes para cada uno de tus %lld personajes. Los cuadros más oscuros tienen más ajustes; los recuadrados tienen ajustes distintos de tus otros personajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld addons gardent des réglages pour chacun de vos %lld personnages. Les cases plus foncées en contiennent davantage ; les cases entourées ont des réglages différents de vos autres personnages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аддонов, хранящих настройки для каждого из ваших персонажей (%2$lld): %1$lld. Чем темнее квадрат, тем больше настроек; обведённые настроены иначе, чем ваши другие персонажи."
          }
        }
      }
    },

    "A backup holds your SavedVariables, AddOnSettings.txt, UserSettings.txt, and the list of installed addons, in Minion's format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Backup enthält Ihre SavedVariables, AddOnSettings.txt, UserSettings.txt und die Liste der installierten AddOns im Minion-Format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad contiene tus SavedVariables, AddOnSettings.txt, UserSettings.txt y la lista de addons instalados, en formato Minion."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde contient vos SavedVariables, AddOnSettings.txt, UserSettings.txt et la liste des addons installés, au format Minion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия содержит ваши SavedVariables, AddOnSettings.txt, UserSettings.txt и список установленных аддонов в формате Minion."
          }
        }
      }
    },
    "AI": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI"
          }
        },

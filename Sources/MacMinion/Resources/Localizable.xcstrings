    "Experimental, work in progress": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell, in Arbeit"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental, en desarrollo"
          }
        },

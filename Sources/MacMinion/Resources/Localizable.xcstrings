    "The folder %@ goes to the Trash. It isn't on ESOUI, so MacMinion can't reinstall it. Saved settings stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ordner %@ wird in den Papierkorb verschoben. Er ist nicht in ESOUI, daher kann MacMinion ihn nicht neu installieren. Gespeicherte Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta %@ va a la Papelera. No está en ESOUI, por lo que MacMinion no puede reinstalarla. Las configuraciones guardadas se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier %@ est envoyé à la Corbeille. Il n'est pas sur ESOUI, donc MacMinion ne peut pas le réinstaller. Les paramètres sauvegardés restent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка %@ отправляется в Корзину. Она не в ESOUI, поэтому MacMinion не может ее переустановить. Сохраненные настройки остаются."
          }
        }
      }
    },
    "The game rewrites SavedVariables and the settings files while it runs and when it quits.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel überschreibt SavedVariables und die Einstellungen, während es läuft und wenn es beendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego reescribe SavedVariables y los archivos de configuración mientras se ejecuta y al cerrarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu réécrit SavedVariables et les fichiers de paramètres pendant son exécution et à la fermeture."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Игра перезаписывает SavedVariables и файлы настроек во время работы и при выходе."
          }
        }
      }
    },
    "These folders go to the Trash: %@. Saved settings stay.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ordner werden in den Papierkorb verschoben: %@. Gespeicherte Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas carpetas van a la Papelera: %@. Las configuraciones guardadas se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces dossiers sont envoyés à la Corbeille : %@. Les paramètres sauvegardés restent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти папки отправляются в Корзину: %@. Сохраненные настройки остаются."
          }
        }
      }
    },

        }
      }
    },
    "Ask %@ to name this table's keys from the addon's source. Sends key names and source lines, never your saved values (Option-Command-N)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bitten, die Schlüssel dieser Tabelle aus dem Quelltext des AddOns zu benennen. Sendet Schlüsselnamen und Quelltextzeilen, nie Ihre gespeicherten Werte (Wahl-Befehl-N)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir a %@ que nombre las claves de esta tabla a partir del código del addon. Envía nombres de claves y líneas de código, nunca tus valores guardados (Opción-Comando-N)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander à %@ de nommer les clés de cette table d'après le code de l'addon. Envoie les noms de clés et des lignes de code, jamais vos valeurs enregistrées (Option-Commande-N)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросить %@ назвать ключи этой таблицы по исходному коду аддона. Отправляются имена ключей и строки кода, но не ваши сохранённые значения (Option-Command-N)"
          }
        }
      }
    },
    "Automatic backups are off.": {

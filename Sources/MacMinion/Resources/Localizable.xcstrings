    "Click a thing to follow it. Thicker lines mean more mentions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf etwas, um es zu verfolgen. Dickere Linien bedeuten mehr Erwähnungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en algo para seguirlo. Las líneas más gruesas significan más menciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un élément pour le suivre. Des lignes plus épaisses signifient plus de mentions."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на объект, чтобы отслеживать его. Более толстые линии означают больше упоминаний."
          }
        }
      }
    },
    "Click a tile to zoom in. The game reads all of this at every login.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf eine Kachel, um hineinzuzoomen. Das Spiel liest all dies bei jedem Login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en un mosaico para hacer zoom. El juego lee todo esto en cada inicio de sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur une tuile pour zoomer. Le jeu lit tout cela à chaque connexion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на плитку, чтобы увеличить масштаб. Игра считывает все это при каждом входе."
          }
        }
      }
    },

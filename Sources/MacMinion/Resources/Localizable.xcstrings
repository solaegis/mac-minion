    "AI features stop working until you paste the key again. MacMinion keeps no other copy.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "KI-Funktionen arbeiten erst wieder, wenn du den Schlüssel erneut einfügst. MacMinion hat keine weitere Kopie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones de IA dejan de funcionar hasta que vuelvas a pegar la clave. MacMinion no guarda otra copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctions d’IA cessent de fonctionner jusqu’à ce que vous colliez de nouveau la clé. MacMinion n’en garde aucune autre copie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции ИИ перестанут работать, пока вы снова не вставите ключ. Другой копии у MacMinion нет."
          }
        }
      }
    },

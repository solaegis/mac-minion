{
  "sourceLanguage" : "en",
  "strings" : {
    "The download failed (%lld)." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Download ist fehlgeschlagen (%lld)." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La descarga falló (%lld)." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le téléchargement a échoué (%lld)." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось скачать (%lld)." } }
      }
    },
    "The download didn't match its checksum." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Download stimmt nicht mit der Prüfsumme überein." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La descarga no coincide con su suma de comprobación." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le téléchargement ne correspond pas à sa somme de contrôle." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Скачанный файл не совпал с контрольной суммой." } }
      }
    },
    "The zip couldn't be unpacked." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Zip-Datei konnte nicht entpackt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo descomprimir el zip." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de décompresser le zip." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось распаковать zip-архив." } }
      }
    },
    "The zip has no addon folders." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Zip-Datei enthält keine Addon-Ordner." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El zip no tiene carpetas de addon." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le zip ne contient aucun dossier d’addon." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В zip-архиве нет папок аддонов." } }
      }
    },
    "This MacMinion doesn't include a copy of ESO Mac Minion to install." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Diese MacMinion-Version enthält keine Kopie von ESO Mac Minion zum Installieren." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Esta MacMinion no incluye una copia de ESO Mac Minion para instalar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Cette version de MacMinion n’inclut pas de copie d’ESO Mac Minion à installer." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В этой сборке MacMinion нет ESO Mac Minion для установки." } }
      }
    },
    "The backup couldn't be unpacked." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Backup konnte nicht entpackt werden." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No se pudo descomprimir la copia de seguridad." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Impossible de décompresser la sauvegarde." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Не удалось распаковать резервную копию." } }
      }
    },
    "ESOUI answered %lld for %@." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI antwortete %lld für %@." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI respondió %lld para %@." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI a répondu %lld pour %@." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI ответил %lld для %@." } }
      }
    },
    "ESOUI has no addon with id %lld." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI hat kein Addon mit der ID %lld." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI no tiene ningún addon con el id %lld." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "ESOUI n’a aucun addon avec l’id %lld." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "В ESOUI нет аддона с id %lld." } }
      }
    },
    "%@ didn't accept the API key. Check your API key in Settings > AI." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ hat den API-Schlüssel nicht akzeptiert. Prüfe den Schlüssel unter Einstellungen > KI." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ no aceptó la clave API. Revisa la clave en Ajustes > IA." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ n’a pas accepté la clé API. Vérifie-la dans Réglages > IA." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ не принял API-ключ. Проверьте ключ в Настройки > ИИ." } }
      }
    },
    "%@ is rate limiting requests. Wait a minute and try again." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ begrenzt die Anfragen. Warte eine Minute und versuche es erneut." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ está limitando las solicitudes. Espera un minuto e inténtalo de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ limite le débit des requêtes. Attends une minute et réessaie." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "%@ ограничивает частоту запросов. Подождите минуту и попробуйте снова." } }
      }
    },
    "%@ is having problems right now. Try again later." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "%@ hat gerade Probleme. Versuche es später erneut." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "%@ tiene problemas ahora mismo. Inténtalo más tarde." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "%@ rencontre des problèmes en ce moment. Réessaie plus tard." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "У %@ сейчас проблемы. Попробуйте позже." } }
      }
    },
    "The AI took too long to answer. Try again." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die KI hat zu lange für eine Antwort gebraucht. Versuche es erneut." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La IA tardó demasiado en responder. Inténtalo de nuevo." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L’IA a mis trop de temps à répondre. Réessaie." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "ИИ слишком долго отвечал. Попробуйте снова." } }
      }
    },
    "The AI service answered %lld." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der KI-Dienst antwortete mit %lld." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El servicio de IA respondió %lld." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le service d’IA a répondu %lld." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сервис ИИ ответил кодом %lld." } }
      }
    },
    "The model declined: %@" : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Modell hat abgelehnt: %@" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El modelo rechazó: %@" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le modèle a refusé : %@" } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Модель отказала: %@" } }
      }
    },
    "The model declined to answer." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Das Modell hat die Antwort abgelehnt." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El modelo se negó a responder." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Le modèle a refusé de répondre." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Модель отказалась отвечать." } }
      }
    },
    "The answer was empty." : {
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Antwort war leer." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "La respuesta estaba vacía." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La réponse était vide." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Ответ был пустым." } }
      }
    },
    "%@ at line %lld, column %lld" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in Zeile %lld, Spalte %lld"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en la línea %lld, columna %lld"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligne %lld, colonne %lld"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в строке %lld, столбец %lld"
          }
        }
      }
    },
    "%@ at line %lld, column %lld. The game can't read the file, so the addon starts with its defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ in Zeile %lld, Spalte %lld. Das Spiel kann die Datei nicht lesen, daher startet das AddOn mit seinen Standardwerten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ en la línea %lld, columna %lld. El juego no puede leer el archivo, así que el addon arranca con sus valores por defecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ligne %lld, colonne %lld. Le jeu ne peut pas lire le fichier : l'addon démarre donc avec ses valeurs par défaut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ в строке %lld, столбец %lld. Игра не может прочитать файл, поэтому аддон запускается с настройками по умолчанию."
          }
        }
      }
    },
    "%@ didn't load: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde nicht geladen: %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ no se cargó: %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ne s'est pas chargé : %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не загрузился: %@."
          }
        }
      }
    },
    "%@ is out of date for this game version." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist für diese Spielversion veraltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ está desactualizado para esta versión del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est obsolète pour cette version du jeu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ устарел для этой версии игры."
          }
        }
      }
    },
    "%@ threw Lua errors %@ last session." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat in der letzten Sitzung %@ Lua-Fehler ausgelöst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ lanzó errores de Lua %@ en la última sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a provoqué des erreurs Lua %@ lors de la dernière session."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ вызвал ошибки Lua %@ в прошлой сессии."
          }
        }
      }
    },
    "%@ took %@ s to load last login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ brauchte beim letzten Login %@ s zum Laden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tardó %@ s en cargar en el último inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ a mis %@ s à se charger à la dernière connexion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ загружался %@ с при последнем входе."
          }
        }
      }
    },
    "%@* values" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@*-Werte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "valores %@*"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "valeurs %@*"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "значения %@*"
          }
        }
      }
    },
    "%@. The game reads every SavedVariables file at each login and reload, so big ones slow loading screens." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Das Spiel liest jede SavedVariables-Datei bei jedem Login und Neuladen, große Dateien verlangsamen also Ladebildschirme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. El juego lee todos los archivos SavedVariables en cada inicio de sesión y recarga, así que los grandes alargan las pantallas de carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Le jeu lit chaque fichier SavedVariables à chaque connexion et rechargement : les gros ralentissent donc les écrans de chargement."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Игра читает каждый файл SavedVariables при каждом входе и перезагрузке, поэтому большие файлы замедляют экраны загрузки."
          }
        }
      }
    },
    "%@; set from LibSets" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@; Set aus LibSets"

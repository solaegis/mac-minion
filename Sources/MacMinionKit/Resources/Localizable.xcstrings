    "Size and speed" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Größe und Tempo"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamaño y velocidad"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taille et vitesse"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Размер и скорость"
          }
        }
      }
    },
    "Some %@ settings mix types" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Einstellungen von %@ mischen Typen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos ajustes de %@ mezclan tipos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains réglages de %@ mélangent les types"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Некоторые настройки %@ смешивают типы"
          }
        }
      }
    },
    "The file stops partway, so the addon may lose its settings at the next login." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Datei bricht mittendrin ab, daher kann das Addon beim nächsten Login seine Einstellungen verlieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo se corta a medias, así que el addon puede perder sus ajustes en el próximo inicio de sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier s’arrête en cours de route, l’addon peut donc perdre ses réglages à la prochaine connexion."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файл обрывается на середине, поэтому при следующем входе аддон может потерять настройки."
          }
        }
      }
    },
    "The game can't read it, so the addon starts with its defaults." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel kann sie nicht lesen, daher startet das Addon mit seinen Standardwerten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego no puede leerlo, así que el addon empieza con sus valores predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu ne peut pas le lire, l’addon démarre donc avec ses réglages par défaut."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра не может его прочитать, поэтому аддон запускается с настройками по умолчанию."
          }
        }
      }
    },
    "The game doesn't make or read them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel erstellt oder liest sie nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego no los crea ni los lee."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu ne les crée ni ne les lit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра их не создаёт и не читает."
          }
        }
      }
    },
    "The game never loads them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel lädt sie nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego nunca los carga."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu ne les charge jamais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра их никогда не загружает."
          }
        }
      }
    },
    "The game reads all of it at every login and reload, so loading screens take longer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Spiel liest alles bei jedem Login und Neuladen, daher dauern Ladebildschirme länger."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego lo lee todo en cada inicio de sesión y recarga, así que las pantallas de carga tardan más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le jeu lit tout à chaque connexion et rechargement, les écrans de chargement durent donc plus longtemps."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Игра читает всё это при каждом входе и перезагрузке, поэтому экраны загрузки длятся дольше."
          }
        }
      }
    },
    "They load only while out-of-date addons are allowed, and can break after a game update." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie laden nur, solange veraltete Addons erlaubt sind, und können nach einem Spiel-Update kaputtgehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se cargan si se permiten addons desactualizados y pueden romperse tras una actualización del juego."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils ne se chargent que si les addons obsolètes sont autorisés et peuvent casser après une mise à jour du jeu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Они загружаются, только пока разрешены устаревшие аддоны, и могут сломаться после обновления игры."
          }
        }
      }
    },
    "Turned on for %@, who may not have played since." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingeschaltet für %@, die seitdem vielleicht nicht gespielt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activado para %@, que quizá no haya jugado desde entonces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activé pour %@, qui n’a peut-être pas joué depuis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включён для %@, кто, возможно, с тех пор не играл."
          }
        }
      }
    },

    "The addon declares %@ but the file has none of them, so the game never loads what's here." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das AddOn deklariert %@, aber die Datei enthält keine davon, das Spiel lädt also nie, was hier steht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El addon declara %@ pero el archivo no tiene ninguna, así que el juego nunca carga lo que hay aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'addon déclare %@ mais le fichier n'en contient aucune : le jeu ne charge donc jamais ce qui s'y trouve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аддон объявляет %@, но в файле нет ни одной из них, поэтому игра не загружает его содержимое."
          }
        }
      }
    },
    "The addon no longer declares %@, so the game never loads it. Left by an older version: %@ it could do without." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das AddOn deklariert %@ nicht mehr, das Spiel lädt sie also nie. Übrig von einer älteren Version: %@, auf die es verzichten könnte."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El addon ya no declara %@, así que el juego nunca la carga. Lo dejó una versión anterior: %@ de los que podría prescindir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'addon ne déclare plus %@ : le jeu ne la charge donc jamais. Laissé par une ancienne version : %@ dont il pourrait se passer."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аддон больше не объявляет %@, поэтому игра её не загружает. Осталось от старой версии: %@, без которых можно обойтись."
          }
        }
      }
    },
